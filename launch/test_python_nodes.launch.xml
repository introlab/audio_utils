<launch>
    <arg name="output_path"/>

    <node pkg="audio_utils" exec="capture_node" name="capture_node">
        <param name="backend" value="alsa"/>
        <param name="device" value="default"/>
        <param name="format" value="signed_16"/>
        <param name="channel_count" value="2"/>
        <param name="sampling_frequency" value="16000"/>
        <param name="frame_sample_count" value="512"/>
        <param name="merge" value="false"/>
        <param name="gain" value="1.0"/>

        <remap from="audio_out" to="audio_c2_16000_signed_16"/>
    </node>
    <node pkg="audio_utils" exec="raw_file_writer_node.py" name="raw_file_writer_node_1">
        <param name="output_path" value="$(var output_path)/audio_c2_16000_signed_16.raw"/>

        <remap from="audio_in" to="audio_c2_16000_signed_16"/>
    </node>

    <node pkg="audio_utils" exec="format_conversion_node.py" name="format_conversion_node">
        <param name="input_format" value="signed_16"/>
        <param name="output_format" value="float"/>

        <remap from="audio_in" to="audio_c2_16000_signed_16"/>
        <remap from="audio_out" to="audio_c2_16000_float"/>
    </node>
    <node pkg="audio_utils" exec="raw_file_writer_node.py" name="raw_file_writer_node_2">
        <param name="output_path" value="$(var output_path)/audio_c2_16000_float.raw"/>

        <remap from="audio_in" to="audio_c2_16000_float"/>
    </node>

    <node pkg="audio_utils" exec="split_channel_node.py" name="split_channel_node">
        <param name="input_format" value="signed_16"/>
        <param name="output_format" value="signed_32"/>
        <param name="channel_count" value="2"/>

        <remap from="audio_in" to="audio_c2_16000_signed_16"/>
        <remap from="audio_out_0" to="audio_16000_signed_32_i1"/>
        <remap from="audio_out_1" to="audio_16000_signed_32_i2"/>
    </node>
    <node pkg="audio_utils" exec="raw_file_writer_node.py" name="raw_file_writer_node_3">
        <param name="output_path" value="$(var output_path)/audio_16000_signed_32_i1.raw"/>

        <remap from="audio_in" to="audio_16000_signed_32_i1"/>
    </node>
    <node pkg="audio_utils" exec="raw_file_writer_node.py" name="raw_file_writer_node_4">
        <param name="output_path" value="$(var output_path)/audio_16000_signed_32_i2.raw"/>

        <remap from="audio_in" to="audio_16000_signed_32_i2"/>
    </node>


</launch>
